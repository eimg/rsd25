// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
    id       Int       @id @default(autoincrement())
    name     String
    username String    @unique
    bio      String?   // Optional field, handle nulls in application logic
    password String    // Store hashed passwords for security
    posts    Post[]    @relation(onDelete: CASCADE) // Optional cascading delete
    comments Comment[]  @relation(onDelete: CASCADE) // Optional cascading delete
    created  DateTime  @default(now())
}

model Post {
    id       Int       @id @default(autoincrement())
    content  String
    user     User      @relation(fields: [userId], references: [id], onDelete: CASCADE) // Optional cascading delete
    userId   Int      // Consider indexing this for performance
    comments Comment[]
    created  DateTime  @default(now())
}

model Comment {
    id      Int      @id @default(autoincrement())
    content String
    user    User     @relation(fields: [userId], references: [id], onDelete: CASCADE) // Optional cascading delete
    userId  Int      // Consider indexing this for performance
    post    Post     @relation(fields: [postId], references: [id], onDelete: CASCADE) // Optional cascading delete
    postId  Int      // Consider indexing this for performance
    created DateTime @default(now())
}